# Copy this file to .env and fill in your own values.
# NEVER put real passwords or keys in this example file: it is committed to Git. .env is not.

# --- Core ---
DATABASE_URL=sqlite:///./portfolio.db
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- First admin (created automatically on first startup if none exists) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Email (leave SMTP_HOST empty to just print emails in the terminal) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=you@example.com
CONTACT_INBOX=you@example.com

# --- GitHub projects (optional: defaults live in app/routers/github.py) ---
# GITHUB_USERNAME=your-github-username
# GITHUB_FEATURED_REPOS=repo-one,repo-two
# GITHUB_MIN_STARS=1
# GITHUB_TOPIC=portfolio
# GITHUB_TOKEN=
# GITHUB_CACHE_MINUTES=30
